{
  "info": {
    "name": "India Financial Fraud Assistance Platform API",
    "description": "Postman API collection for testing Auth, Providers, Classification, Incidents, Action Items, References, and Complaint Drafts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public - Classify Intake (PhonePe 10k Fraud)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payment_method\": \"UPI\",\n  \"was_deceived\": true,\n  \"money_debited\": true,\n  \"transaction_status\": \"SUCCESS\",\n  \"amount\": 10000,\n  \"customer_description\": \"Deceived into paying utility bill scam\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/incidents/classify/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "incidents", "classify", ""]
        }
      }
    },
    {
      "name": "2. Auth - Login Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul.sharma@example.com\",\n  \"password\": \"Customer@12345\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/auth/login/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "auth", "login", ""]
        }
      }
    },
    {
      "name": "3. Providers - List Providers",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/providers/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "providers", ""]
        }
      }
    },
    {
      "name": "4. Incidents - List Cases",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/incidents/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "incidents", ""]
        }
      }
    }
  ]
}
