DJANGO_SECRET_KEY=django-insecure-india-fraud-assistance-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Set DB_ENGINE=mysql to use MySQL 8.x, or leave empty/sqlite for SQLite
DB_ENGINE=sqlite
DB_NAME=financial_fraud_assistance_db
DB_USER=fraud_app_user
DB_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

MEDIA_ROOT=private_media
MAX_UPLOAD_SIZE_MB=10
